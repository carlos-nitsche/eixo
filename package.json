{
  "name": "eixo-life-os",
  "private": true,
  "version": "0.9.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "start": "node server.mjs",
    "typecheck": "tsc --noEmit",
    "test:demo:unit": "node --experimental-strip-types --test tests/demo-state.test.mjs",
    "test:demo": "npm run test:demo:unit && npm run build && node tests/demo-complete-e2e.mjs",
    "test:postgres:qa": "node scripts/test-qa-pg-migration.mjs",
    "test:postgres:rollback": "node scripts/test-qa-pg-rollback.mjs",
    "test:postgres:real": "node scripts/foundation-real-postgres-qa.mjs",
    "test:business:unit": "node --experimental-strip-types --test tests/business-insights.test.mjs",
    "test:pricing:unit": "node --experimental-strip-types --test tests/product-pricing.test.mjs",
    "test:receipts:unit": "node --experimental-strip-types --test tests/sales-receipt.test.mjs",
    "test:receipts:visual": "node --experimental-strip-types scripts/qa-receipt-visual.mjs",
    "test:reports:unit": "node --experimental-strip-types --test tests/business-reports.test.mjs",
    "test:reports:e2e": "node scripts/test-business-e2e.mjs",
    "test:business:visual": "npm run test:visual",
    "test:production-guards": "node --test tests/production-runtime.test.mjs",
    "test:asaas:production-mock": "node scripts/test-asaas-production-mock.mjs",
    "asaas:production:webhook": "node scripts/asaas-production-webhook.mjs",
    "test:visual": "npm run build && node scripts/test-visual.mjs",
    "brand:generate": "node scripts/generate-brand.mjs",
    "test:training:unit": "node --experimental-strip-types --test tests/training-calendar.test.mjs tests/muscle-map.test.mjs tests/training-presets.test.mjs tests/custom-muscle-icons.test.mjs",
    "test:training": "npm run test:training:unit && npm run build && node tests/training-calendar-e2e.mjs && node tests/training-visual-e2e.mjs && node tests/muscle-map-e2e.mjs",
    "test:nutrition": "node --experimental-strip-types --test tests/nutrition.test.mjs && npm run build && node tests/nutrition-e2e.mjs",
    "test:study:unit": "node --experimental-strip-types --test tests/study.test.mjs tests/study-domain.test.mjs tests/brain.test.mjs",
    "test:study:notebook": "npm run test:study:unit && npm run build && node tests/study-notebook-e2e.mjs",
    "test:finance:unit": "node --experimental-strip-types --test tests/financial-planning.test.mjs tests/action-center.test.mjs",
    "test:finance:e2e": "npm run build && node tests/financial-planner-e2e.mjs",
    "test:day:unit": "node --experimental-strip-types --test tests/day-planner.test.mjs",
    "test:day:e2e": "npm run build && node tests/day-command-e2e.mjs",
    "test:assistant:unit": "node --experimental-strip-types --test tests/assistant-local.test.mjs",
    "test:assistant:e2e": "npm run build && node tests/assistant-chat-e2e.mjs",
    "voice:install": "node scripts/install-local-whisper.mjs"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.9",
    "@huggingface/transformers": "3.8.1",
    "@zxing/browser": "^0.2.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.55.0",
    "nodemailer": "^10.1.0",
    "pg": "^8.23.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "recharts": "^3.10.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "puppeteer-core": "^25.13.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
